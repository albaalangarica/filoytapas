# Copia este archivo como .env.local para desarrollo. En Vercel, añade las mismas variables
# en Settings → Environment Variables. Sin las variables de Google, en local la app arranca
# en modo demo con datos de ejemplo.

# ID del Google Sheet (lo que va entre /d/ y /edit en su URL)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Cuenta de servicio de Google Cloud con acceso de Editor al Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=filoytapas@tu-proyecto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Secreto para firmar la sesión (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Opcional: fuerza el modo demo (datos de ejemplo en memoria) aunque estés en producción.
# APP_MODE=demo
